{
  "manifestVersion": 5,
  "id": "com.photogit.development",
  "name": "PhotoGit",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0",
    "data": { "apiVersion": 2 }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "photogitPanel",
      "label": { "default": "PhotoGit" },
      "minimumSize": { "width": 230, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 230, "height": 300 },
      "preferredFloatingSize": { "width": 230, "height": 300 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/photogit-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["generic"] },
        { "width": 23, "height": 23, "path": "icons/photogit-light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/photogit-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["generic"] },
    { "width": 23, "height": 23, "path": "icons/photogit-light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic"] }
  ]
}
