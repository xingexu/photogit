{
  "manifestVersion": 5,
  "id": "com.xinge.photogit",
  "name": "PhotoGit",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "photogitPanel",
      "label": {
        "default": "PhotoGit"
      },
      "minimumSize": {
        "width": 230,
        "height": 300
      },
      "maximumSize": {
        "width": 800,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://127.0.0.1:17371"
      ]
    }
  }
}
